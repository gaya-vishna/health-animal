# Health Animal Server Environment Variables
# Copy this file to server/.env (for Docker: the root ./.env) BEFORE running db:push, and fill in your values

# Gemini Flash API Key - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default 5000). If you change it in development, also set VITE_API_BASE_URL (client) so the Vite proxy follows.
PORT=5000

# Secret used to sign login tokens - set a long random string on the server.
# Required when NODE_ENV=production (the server refuses to start with the placeholder).
JWT_SECRET=change_me_to_a_long_random_string

# Optional: shared key for the Android app to ask this server for AI estimates.
# Use at least 24 random characters (e.g. `openssl rand -hex 24`). It gets baked into APKs you build,
# so keep it private. Shorter values disable the feature.
APP_KEY=

# SQLite path (relative to prisma/ locally; /data/health.db in Docker)
DATABASE_URL="file:./dev.db"

# NODE_ENV: set to "production" when deploying (Docker does this for you). Production enforces a real JWT_SECRET.
# NODE_ENV=production

# Optional: preferred Gemini model, tried before the built-in defaults
# GEMINI_MODEL=

# Optional: set to false to close sign-ups once your accounts exist (without REQUIRE_PASSWORD, login is by name only)
# ALLOW_REGISTER=false

# Optional: set to 1 when running behind a reverse proxy so rate limits see real client IPs
# TRUST_PROXY=1

# Time zone, so "today" starts at local midnight (e.g. Europe/London). Docker Compose reads it from the root .env
# or your shell (default UTC); outside Docker it is the machine's own time zone. The app code does not read it.
# TZ=

# Optional: set to true to make every account need a password (register requires one, login checks it).
# Recommended whenever the server is reachable by anyone beyond people you fully trust.
# REQUIRE_PASSWORD=true

# Optional: comma-separated origins allowed to call the API from another site, e.g. http://192.168.1.5:5173
# Empty (default) = same origin only: the web client served by this server needs nothing here.
# CORS_ORIGINS=

# Address to listen on. Default 127.0.0.1 (this machine only). Docker Compose sets 0.0.0.0 inside the container;
# use 0.0.0.0 elsewhere only on a trusted LAN/VPN.
# HOST=127.0.0.1
