# Build-time settings for the client. Copy to client/.env.local (untracked) and fill in what you need.

# API base URL for a web build served from a different origin than the server. Leave empty to use the same origin.
# Also the Vite dev proxy target (client/vite.config.js; read from the shell environment only, default http://localhost:5000).
VITE_API_BASE_URL=

# Android app only: comma-separated addresses of YOUR server, e.g. http://<your-server>:8090
# Leave empty to skip the server (use your own Gemini key in Settings, or offline estimates).
VITE_AI_SERVERS=

# Android app only: must match APP_KEY in the server's .env. It gets baked into the APK, so never publish that APK.
VITE_APP_KEY=

# Optional: URL of an Android APK for the web Settings page to link to. Leave empty to hide the link.
VITE_APK_DOWNLOAD_URL=
